# ─────────────────────────────────────────────
# LLM-Coding-Race 环境变量模板
# 复制为 .env 后填入真实值；.env 已在 .gitignore 中
# ─────────────────────────────────────────────

# Project B（harness）评测模型 API Key
# Anthropic Claude（claude-opus-4-7，PRD §B6 默认不直连，可留空）
ANTHROPIC_API_KEY=

# DeepSeek（deepseek-v4-pro），endpoint: https://api.deepseek.com
DEEPSEEK_API_KEY=

# 智谱（glm-5.1），endpoint: https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=

# Project B fetch 阶段：HTTPS clone 私有 GitHub 仓库时使用
# 注意：clone 完成后 harness 会自动从 .git/config 清除该 token
GITHUB_TOKEN=

# Project A（taskprep）草稿生成用 LLM；可与上述任一 KEY 复用
# 留空时 taskprep 会回落到 ANTHROPIC_API_KEY
TASKPREP_LLM_API_KEY=
